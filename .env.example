MONGODB_URI=mongodb://127.0.0.1:27017/shopease
PORT=5001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@shopease.com
ADMIN_PASSWORD=replace-with-a-strong-password
FRONTEND_URL=http://localhost:5173

# Optional: Google and Facebook sign-in
# Register the callback URLs in your provider dashboards.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5001/api/auth/facebook/callback

# Required for password reset verification-code emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

